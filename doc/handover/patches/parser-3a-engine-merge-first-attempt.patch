diff --git a/rs/tests/merge_test.rs b/rs/tests/merge_test.rs
index 90789cc..704d1d5 100644
--- a/rs/tests/merge_test.rs
+++ b/rs/tests/merge_test.rs
@@ -443,3 +443,176 @@ fn merged_alternates_follow_token_set_overrides_on_either_side_of_the_merge() {
     merged.grammar_json(OVERRIDE).unwrap();
     expect(&merged, "x", "true");
 }
+
+/// A merge side: the default options under `tag`, then each serialized
+/// grammar in turn, the door a plugin's `fixed.token` deletions come through.
+fn spec_side(tag: &str, specs: &[&str]) -> Tabnas {
+    let mut tabnas = Tabnas::with_options(Options {
+        tag: tag.into(),
+        ..Default::default()
+    });
+    for spec in specs {
+        tabnas.grammar_json(spec).unwrap();
+    }
+    tabnas
+}
+
+/// The token names `tabnas` lexes `src` into, the end token left out.
+fn lexed(tabnas: &Tabnas, src: &str) -> String {
+    let mut probe = tabnas.clone();
+    let names = Arc::new(Mutex::new(Vec::new()));
+    let seen = names.clone();
+    probe.subscribe_lex(move |token, _, _| {
+        let name = token.name.to_string();
+        if name != "#ZZ" {
+            seen.lock().unwrap().push(name);
+        }
+    });
+    let _ = probe.parse(src);
+    let names = names.lock().unwrap().join(",");
+    names
+}
+
+/// Every merge of a side built from `deleter` with one built from `other`:
+/// the side that deletes sorts first and last by tag, and each is the
+/// receiver once, so no order can hide a result.
+fn merges_of(deleter: &[&str], other: &[&str]) -> Vec<Result<Tabnas, String>> {
+    let mut out = Vec::new();
+    for (deleter_tag, other_tag) in [("A", "B"), ("B", "A")] {
+        for deleter_receives in [true, false] {
+            let deleting = spec_side(deleter_tag, deleter);
+            let keeping = spec_side(other_tag, other);
+            let merged = if deleter_receives {
+                deleting.merge(&keeping)
+            } else {
+                keeping.merge(&deleting)
+            };
+            out.push(merged.map_err(|error| error.to_string()));
+        }
+    }
+    out
+}
+
+const TOP: &str = r##"{"options":{"rule":{"start":"top"}},
+  "rule":{"top":{"open":[{"s":["#OS"]},{"s":["#OB"]},{"s":["#CA"]},{"s":["#TX"]}]}}}"##;
+
+#[test]
+fn a_fixed_token_one_side_removed_comes_back_from_the_other_side() {
+    // TypeScript's configure() deletes a fixed token set to null from the
+    // option tree a merge reads, so the merge takes the binding the other
+    // side holds: `css` removes `[` and `]`, and a css~jsonic merge lexes
+    // them as `#OS` and `#CS` again. The Rust merge used to keep the removal.
+    const REMOVE: &str = r##"{"options":{"fixed":{"token":{"#OS":null,"#CS":null}}}}"##;
+    let alone = spec_side("A", &[TOP, REMOVE]);
+    assert_eq!("#TX", lexed(&alone, "["));
+    for merged in merges_of(&[TOP, REMOVE], &[TOP]) {
+        let merged = merged.unwrap();
+        assert_eq!("#OS", lexed(&merged, "["));
+        assert_eq!("#CS", lexed(&merged, "]"));
+    }
+
+    // A `clear` removes every fixed token, and they come back the same way.
+    const CLEAR: &str = r##"{"clear":true,"options":{"rule":{"start":"top"}},
+      "rule":{"top":{"open":[{"s":["#TX"]}]}}}"##;
+    for merged in merges_of(&[CLEAR], &[TOP]) {
+        let merged = merged.unwrap();
+        assert_eq!("#OS", lexed(&merged, "["));
+        assert_eq!("#OB", lexed(&merged, "{"));
+    }
+
+    // What comes back is the other side's binding, default or not: a
+    // removal is not a value that conflicts with it.
+    const REBIND: &str = r##"{"options":{"fixed":{"token":{"#OS":"<<"}}}}"##;
+    for merged in merges_of(&[TOP, REMOVE], &[TOP, REBIND]) {
+        let merged = merged.unwrap();
+        assert_eq!("#OS", lexed(&merged, "<<"));
+        assert_eq!("#TX", lexed(&merged, "["));
+    }
+}
+
+#[test]
+fn a_default_fixed_token_neither_side_holds_comes_back() {
+    // TypeScript builds the merged instance over the defaults, so a default
+    // fixed token that both sides removed comes back too.
+    const REMOVE: &str = r##"{"options":{"fixed":{"token":{"#OS":null}}}}"##;
+    for merged in merges_of(&[TOP, REMOVE], &[TOP, REMOVE]) {
+        assert_eq!("#OS", lexed(&merged.unwrap(), "["));
+    }
+    const CLEAR: &str = r##"{"clear":true,"options":{"rule":{"start":"top"}},
+      "rule":{"top":{"open":[{"s":["#TX"]}]}}}"##;
+    for merged in merges_of(&[CLEAR], &[CLEAR]) {
+        let merged = merged.unwrap();
+        assert_eq!("#OB", lexed(&merged, "{"));
+        assert_eq!("#OS", lexed(&merged, "["));
+        assert_eq!("#CL", lexed(&merged, ":"));
+        assert_eq!("#CA", lexed(&merged, ","));
+    }
+
+    // Where a default that comes back and a binding a side holds claim one
+    // source, the later of the two in the defaults' order lexes it: a name
+    // the defaults lack, or a default name after it, keeps the source, and
+    // a default name before it gives the source up.
+    for (bind, source_lexes_as, freed, freed_lexes_as) in [
+        (r##""#LB":"[""##, "#LB", "{", "#OB"),
+        (r##""#CA":"[""##, "#CA", ",", "#TX"),
+        (r##""#OB":"[""##, "#OS", "{", "#TX"),
+    ] {
+        let spec = format!(r##"{{"options":{{"fixed":{{"token":{{"#OS":null,{bind}}}}}}}}}"##);
+        for merged in merges_of(&[TOP, &spec], &[TOP, &spec]) {
+            let merged = merged.unwrap();
+            assert_eq!(source_lexes_as, lexed(&merged, "["), "{bind}");
+            assert_eq!(freed_lexes_as, lexed(&merged, freed), "{bind}");
+        }
+    }
+}
+
+#[test]
+fn a_removed_fixed_tokens_source_bound_to_another_name_meets_the_other_sides_binding() {
+    // The other side's `#OS` comes back, so two names claim `[`, and the
+    // merge refuses them as TypeScript does, naming the canonical-first
+    // side's claim first.
+    const MOVE: &str = r##"{"options":{"fixed":{"token":{"#OS":null,"#LB":"["}}}}"##;
+    let errors = merges_of(&[TOP, MOVE], &[TOP])
+        .into_iter()
+        .map(|merged| merged.err().unwrap())
+        .collect::<Vec<_>>();
+    let deleter_first = r#"merge: fixed tokens #LB and #OS both claim source "[""#;
+    let deleter_second = r#"merge: fixed tokens #OS and #LB both claim source "[""#;
+    assert_eq!(
+        vec![deleter_first, deleter_first, deleter_second, deleter_second],
+        errors
+    );
+}
+
+#[test]
+fn a_removal_of_any_other_option_or_of_a_rule_merges_as_before() {
+    // Only the fixed tokens lose their removals to a merge. A value
+    // definition set to null stays removed against the unchanged default
+    // and conflicts with a different one, as in TypeScript, where the null
+    // stays in the option tree.
+    const VALUES: &str = r##"{"options":{"rule":{"start":"top"}},
+      "rule":{"top":{"open":[{"s":["#VL"]},{"s":["#TX"]}]}}}"##;
+    const REMOVE: &str = r##"{"options":{"value":{"def":{"true":null}}}}"##;
+    assert_eq!("#VL", lexed(&spec_side("A", &[VALUES]), "true"));
+    for merged in merges_of(&[VALUES, REMOVE], &[VALUES]) {
+        assert_eq!("#TX", lexed(&merged.unwrap(), "true"));
+    }
+    const REDEFINE: &str = r##"{"options":{"value":{"def":{"true":{"val":1}}}}}"##;
+    for merged in merges_of(&[VALUES, REMOVE], &[VALUES, REDEFINE]) {
+        assert_eq!(
+            "merge: conflicting option values at value.def.true",
+            merged.err().unwrap()
+        );
+    }
+
+    // A rule one side removed is the other side's rule in the merge.
+    const RULES: &str = r##"{"options":{"rule":{"start":"top"}},
+      "rule":{"top":{"open":[{"s":["#TX"],"p":"x"}]},"x":{"open":[{"s":["#NR"]}]}}}"##;
+    const DROP: &str = r##"{"rule":{"x":null}}"##;
+    assert!(spec_side("A", &[RULES, DROP]).parse("a 1").is_err());
+    for merged in merges_of(&[RULES, DROP], &[RULES]) {
+        let merged = merged.unwrap();
+        assert!(merged.rules.contains_key("x"));
+        assert!(merged.parse("a 1").is_ok());
+    }
+}
