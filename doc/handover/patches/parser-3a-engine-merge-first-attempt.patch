+/// The fixed tokens do not merge as the other maps do: a removal of one
+/// does not survive a merge, as in TypeScript. There, `configure()`
+/// deletes a binding set to `null` from the live option tree (`clean`,
+/// `ts/src/utility.ts`), where the other maps keep the `null`, so the tree
+/// a merge reads holds no removal: the merge takes every binding either
+/// side holds, picking between two as any option is picked, and builds the
+/// merged instance over the defaults, which puts back a default binding
+/// that neither side holds. Where a default put back and a binding held
+/// claim one source, the one later in that default-first order lexes it,
+/// since `configure()` maps each source to the last name that claims it.
+/// So `css`, which removes `#OS` and `#CS`, merged with `jsonic` lexes `[`
+/// and `]` as `#OS` and `#CS`, as TypeScript's merge does.
+///
+/// Two held bindings that claim one source are left to
+/// `merge_token_space` to refuse, as TypeScript refuses them before the
+/// defaults are applied. Rust keeps no mark of an instance built without
+/// the defaults (TypeScript's `defaults$: false`, which its `empty()`
+/// sets), and `merge_options` measures every option against
+/// `Options::default()`, so two `Tabnas::empty()` instances merged get the
+/// default bindings back here, where TypeScript's merge leaves them out.
+fn merge_fixed_tokens(
+    left: &IndexMap<String, FixedToken>,
+    right: &IndexMap<String, FixedToken>,
+    default: &IndexMap<String, FixedToken>,
+) -> Result<IndexMap<String, FixedToken>, MergeError> {
+    let mut out = IndexMap::new();
+    for key in ordered_keys(left, right) {
+        let path = format!("fixed.token.{key}");
+        let value = match (left.get(&key), right.get(&key), default.get(&key)) {
+            (Some(left), Some(right), Some(default)) => {
+                pick(left, right, default, &path, &eq_fixed_token)?
+            }
+            (Some(left), Some(right), None) => {
+                pick_without_default(left, right, &path, &eq_fixed_token)?
+            }
+            (Some(value), None, _) | (None, Some(value), _) => value.clone(),
+            (None, None, _) => unreachable!(),
+        };
+        out.insert(key, value);
+    }
+
+    let mut sources = HashSet::new();
+    let distinct_sources = out.values().all(|token| sources.insert(&token.source));
+    if !distinct_sources {
+        return Ok(out);
+    }
+    for (index, (name, token)) in default.iter().enumerate() {
+        if out.contains_key(name) {
+            continue;
+        }
+        let holder = out
+            .iter()
+            .find(|(_, held)| held.source == token.source)
+            .map(|(holder, _)| holder.clone());
+        match holder {
+            // The holder comes later, a name the defaults lack or a default
+            // name after this one, and keeps the source.
+            Some(holder) if default.get_index_of(&holder).is_none_or(|at| at > index) => {}
+            // A default name before this one gives the source up, and with
+            // it the only thing it lexed.
+            Some(holder) => {
+                out.shift_remove(&holder);
+                out.insert(name.clone(), token.clone());
+            }
+            None => {
+                out.insert(name.clone(), token.clone());
+            }
+        }
+    }
+    Ok(out)
+}
+
 fn merge_hash_map<T: Clone>(
     left: &HashMap<String, T>,
     right: &HashMap<String, T>,
@@ -346,12 +419,10 @@ fn merge_options(left: &Options, right: &Options) -> Result<Options, MergeError>
