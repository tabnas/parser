index 6438876..9d0396d 100644
--- a/ts/test/merge.test.js
+++ b/ts/test/merge.test.js
@@ -775,3 +775,159 @@ describe('merge-permutations', () => {
   })
 
 })
+
+
+// A fixed token set to null is deleted from the option tree by
+// configure() (`clean`, src/utility.ts), so a merge never sees the
+// removal: it takes the binding the other side holds, and the merged
+// instance, built over the defaults, gets back a default binding neither
+// side holds. Other removals stay in the tree as null and merge as values.
+// rs/tests/merge_test.rs holds the Rust port to the same results.
+describe('merge-removals', () => {
+  const TOP = {
+    options: { rule: { start: 'top' } },
+    rule: {
+      top: {
+        open: [{ s: ['#OS'] }, { s: ['#OB'] }, { s: ['#CA'] }, { s: ['#TX'] }],
+      },
+    },
+  }
+
+  function side(tag, specs) {
+    const tn = new Tabnas({ tag })
+    for (const spec of specs) {
+      tn.grammar(JSON.parse(JSON.stringify(spec)))
+    }
+    return tn
+  }
+
+  // The token names `tn` lexes `src` into, the end token left out.
+  function lexed(tn, src) {
+    const names = []
+    const probe = tn.make()
+    probe.sub({ lex: (tkn) => '#ZZ' !== tkn.name && names.push(tkn.name) })
+    try {
+      probe.parse(src)
+    } catch (e) {
+      // Only the tokens are observed.
+    }
+    return names.join(',')
+  }
+
+  // The deleting side sorts first and last by tag, and each side is the
+  // receiver once.
+  function mergesOf(deleter, other) {
+    const out = []
+    for (const [dtag, otag] of [['A', 'B'], ['B', 'A']]) {
+      for (const deleterReceives of [true, false]) {
+        const d = side(dtag, deleter)
+        const o = side(otag, other)
+        out.push(() => (deleterReceives ? d.merge(o) : o.merge(d)))
+      }
+    }
+    return out
+  }
+
+  it('restores-a-fixed-token-one-side-removed', () => {
+    const REMOVE = { options: { fixed: { token: { '#OS': null, '#CS': null } } } }
+    for (const merge of mergesOf([TOP, REMOVE], [TOP])) {
+      const merged = merge()
+      assert.equal(lexed(merged, '['), '#OS')
+      assert.equal(lexed(merged, ']'), '#CS')
+    }
+    const CLEAR = {
+      clear: true,
+      options: { rule: { start: 'top' } },
+      rule: { top: { open: [{ s: ['#TX'] }] } },
+    }
+    for (const merge of mergesOf([CLEAR], [TOP])) {
+      const merged = merge()
+      assert.equal(lexed(merged, '['), '#OS')
+      assert.equal(lexed(merged, '{'), '#OB')
+    }
+    const REBIND = { options: { fixed: { token: { '#OS': '<<' } } } }
+    for (const merge of mergesOf([TOP, REMOVE], [TOP, REBIND])) {
+      const merged = merge()
+      assert.equal(lexed(merged, '<<'), '#OS')
+      assert.equal(lexed(merged, '['), '#TX')
+    }
+  })
+
+  it('restores-a-default-fixed-token-neither-side-holds', () => {
+    const REMOVE = { options: { fixed: { token: { '#OS': null } } } }
+    for (const merge of mergesOf([TOP, REMOVE], [TOP, REMOVE])) {
+      assert.equal(lexed(merge(), '['), '#OS')
+    }
+    const CLEAR = {
+      clear: true,
+      options: { rule: { start: 'top' } },
+      rule: { top: { open: [{ s: ['#TX'] }] } },
+    }
+    for (const merge of mergesOf([CLEAR], [CLEAR])) {
+      const merged = merge()
+      assert.equal(lexed(merged, '{'), '#OB')
+      assert.equal(lexed(merged, '['), '#OS')
+      assert.equal(lexed(merged, ':'), '#CL')
+      assert.equal(lexed(merged, ','), '#CA')
+    }
+    // The later of two names claiming one source, in the defaults'
+    // order, lexes it.
+    for (const [bind, lexesAs, freed, freedAs] of [
+      [{ '#LB': '[' }, '#LB', '{', '#OB'],
+      [{ '#CA': '[' }, '#CA', ',', '#TX'],
+      [{ '#OB': '[' }, '#OS', '{', '#TX'],
+    ]) {
+      const spec = { options: { fixed: { token: { '#OS': null, ...bind } } } }
+      for (const merge of mergesOf([TOP, spec], [TOP, spec])) {
+        const merged = merge()
+        assert.equal(lexed(merged, '['), lexesAs, JSON.stringify(bind))
+        assert.equal(lexed(merged, freed), freedAs, JSON.stringify(bind))
+      }
+    }
+  })
+
+  it('refuses-a-removed-fixed-tokens-source-bound-to-another-name', () => {
+    const MOVE = { options: { fixed: { token: { '#OS': null, '#LB': '[' } } } }
+    const errors = mergesOf([TOP, MOVE], [TOP]).map((merge) => {
+      try {
+        merge()
+      } catch (e) {
+        return e.message
+      }
+      return 'merged'
+    })
+    const first = 'merge: fixed tokens #LB and #OS both claim source "["'
+    const second = 'merge: fixed tokens #OS and #LB both claim source "["'
+    assert.deepEqual(errors, [first, first, second, second])
+  })
+
+  it('keeps-a-removal-of-any-other-option-and-restores-a-rule', () => {
+    const VALUES = {
+      options: { rule: { start: 'top' } },
+      rule: { top: { open: [{ s: ['#VL'] }, { s: ['#TX'] }] } },
+    }
+    const REMOVE = { options: { value: { def: { true: null } } } }
+    for (const merge of mergesOf([VALUES, REMOVE], [VALUES])) {
+      assert.equal(lexed(merge(), 'true'), '#TX')
+    }
+    const REDEFINE = { options: { value: { def: { true: { val: 1 } } } } }
+    for (const merge of mergesOf([VALUES, REMOVE], [VALUES, REDEFINE])) {
+      assert.throws(merge, /merge: conflicting option values at value\.def\.true/)
+    }
+
+    const RULES = {
+      options: { rule: { start: 'top' } },
+      rule: {
+        top: { open: [{ s: ['#TX'], p: 'x' }] },
+        x: { open: [{ s: ['#NR'] }] },
+      },
+    }
+    const DROP = { rule: { x: null } }
+    assert.throws(() => side('A', [RULES, DROP]).parse('a 1'))
+    for (const merge of mergesOf([RULES, DROP], [RULES])) {
+      const merged = merge()
+      assert.ok(merged.rule('x'))
+      merged.parse('a 1')
+    }
+  })
+})
