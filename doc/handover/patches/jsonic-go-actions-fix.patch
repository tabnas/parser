diff --git a/rs/tests/grammar_alts_test.rs b/rs/tests/grammar_alts_test.rs
new file mode 100644
index 0000000..9aa95ff
--- /dev/null
+++ b/rs/tests/grammar_alts_test.rs
@@ -0,0 +1,336 @@
+// The installed alternates of every jsonic rule are the TypeScript ones.
+//
+// `test/grammar/alternates.json` is the TypeScript grammar's own dump,
+// per option profile, written by `ts/test/grammar-alts.js` (whose header
+// describes the form) and held to the live TypeScript grammar by
+// `ts/test/grammar-alts.test.js`. The Go runner is
+// `go/grammar_alts_test.go`. This one dumps the grammar Rust installed,
+// read from `Tabnas::rules`, into the same form and compares: the same
+// order, token slots, push, replace, backtrack, condition, counters,
+// props, groups, and the same actions, down to the builtin each
+// alternate runs and the `implicit` config it carries.
+//
+// One allowance the other runners do not need. A function local to the
+// grammar is compared as a grammar function, not by name: this port
+// registers the pair-key action as `@jsonic-pairkey`, and the engine
+// keeps no name for an alternate's error function at all. An engine
+// builtin is still compared by name and config.
+
+mod common;
+
+use std::collections::BTreeMap;
+
+use serde_json::{json, Map, Value as J};
+use tabnas::rule::{AltSpec, CompareOp};
+use tabnas::Tabnas;
+use tabnas_jsonic::make_with;
+
+const FIELDS: [&str; 12] = ["s", "p", "r", "b", "c", "n", "u", "k", "g", "a", "e", "h"];
+
+fn fixture() -> J {
+    let path = common::spec_dir()
+        .join("..")
+        .join("grammar")
+        .join("alternates.json");
+    let text = std::fs::read_to_string(&path)
+        .unwrap_or_else(|error| panic!("read {}: {error}", path.display()));
+    serde_json::from_str(&text).unwrap_or_else(|error| panic!("parse {}: {error}", path.display()))
+}
+
+/// Build the instance a profile asks for. Only the options the grammar is
+/// conditional on are supported; anything else is an error rather than a
+/// stock parser, since a profile that quietly ran without its options
+/// would compare the wrong grammar.
+fn make_profile(options: &J) -> Result<Tabnas, String> {
+    let flag = |section: &str, name: &str| -> Result<Option<bool>, String> {
+        match options.get(section).and_then(|s| s.get(name)) {
+            None => Ok(None),
+            Some(J::Bool(value)) => Ok(Some(*value)),
+            Some(other) => Err(format!("{section}.{name}: not a boolean: {other}")),
+        }
+    };
+    for (section, names) in [
+        ("map", &["child"][..]),
+        ("list", &["child", "property", "pair"][..]),
+    ] {
+        if let Some(entries) = options.get(section).and_then(J::as_object) {
+            if let Some(unknown) = entries.keys().find(|key| !names.contains(&key.as_str())) {
+                return Err(format!("unsupported option {section}.{unknown}"));
+            }
+        }
+    }
+    if let Some(unknown) = options
+        .as_object()
+        .and_then(|o| o.keys().find(|key| *key != "map" && *key != "list"))
+    {
+        return Err(format!("unsupported option {unknown}"));
+    }
+    let map_child = flag("map", "child")?;
+    let list_child = flag("list", "child")?;
+    let list_property = flag("list", "property")?;
+    let list_pair = flag("list", "pair")?;
+    Ok(make_with(move |o| {
+        if let Some(v) = map_child {
+            o.map.child = v;
+        }
+        if let Some(v) = list_child {
+            o.list.child = v;
+        }
+        if let Some(v) = list_property {
+            o.list.property = v;
+        }
+        if let Some(v) = list_pair {
+            o.list.pair = v;
+        }
+    }))
+}
+
+fn op(o: CompareOp) -> &'static str {
+    match o {
+        CompareOp::Eq => "$eq",
+        CompareOp::Ne => "$ne",
+        CompareOp::Lt => "$lt",
+        CompareOp::Lte => "$lte",
+        CompareOp::Gt => "$gt",
+        CompareOp::Gte => "$gte",
+        CompareOp::Exist => "$exist",
+    }
+}
+
+fn object_or_null(entries: Map<String, J>) -> J {
+    if entries.is_empty() {
+        J::Null
+    } else {
+        J::Object(entries)
+    }
+}
+
+/// One installed alternate in the fixture's form.
+fn dump_alt(parser: &Tabnas, alt: &AltSpec) -> J {
+    let s: Vec<Vec<String>> = if alt.s_names.is_empty() {
+        alt.s
+            .iter()
+            .map(|slot| slot.iter().map(|tin| parser.token_name(*tin)).collect())
+            .collect()
+    } else {
+        alt.s_names.clone()
+    };
+
+    let mut g: Vec<String> = alt
+        .g
+        .split(',')
+        .map(|tag| tag.trim().to_string())
+        .filter(|tag| !tag.is_empty())
+        .collect();
+    g.sort();
+
+    let local = || json!({ "fn": "" });
+    let c = if !alt.c.is_empty() {
+        let mut conds = Map::new();
+        for cond in &alt.c {
+            conds.insert(
+                cond.path.join("."),
+                json!({ op(cond.op): cond.value.to_json() }),
+            );
+        }
+        J::Object(conds)
+    } else if let Some(name) = &alt.c_ref {
+        json!({ "fn": name })
+    } else if alt.c_fn.is_some()
+        || alt.c_match.is_some()
+        || alt.c_lex.is_some()
+        || alt.c_lex_match.is_some()
+    {
+        local()
+    } else {
+        J::Null
+    };
+
+    let mut actions: Vec<J> = Vec::new();
+    for name in &alt.a {
+        if name.ends_with('$') {
+            let mut entry = json!({ "ref": name });
+            if name == "@object$" || name == "@array$" {
+                let implicit = alt
+                    .action_configs
+                    .get(&name[1..])
+                    .or_else(|| alt.action_configs.get(name.as_str()))
+                    .map(|config| config.to_json())
+                    .and_then(|config| config.get("implicit").and_then(J::as_bool))
+                    .unwrap_or(false);
+                entry["implicit"] = json!(implicit);
+            }
+            actions.push(entry);
+        } else {
+            actions.push(json!({ "fn": name }));
+        }
+    }
+    actions.extend(alt.action_fns.iter().map(|_| local()));
+    actions.extend(alt.matched_action_fns.iter().map(|_| local()));
+
+    let n: BTreeMap<&String, i32> = alt.n.iter().map(|(k, v)| (k, *v)).collect();
+    let u: Map<String, J> = alt
+        .u
+        .iter()
+        .map(|(k, v)| (k.clone(), v.to_json()))
+        .collect();
+    let k: Map<String, J> = alt
+        .k
+        .iter()
+        .map(|(k, v)| (k.clone(), v.to_json()))
+        .collect();
+
+    json!({
+        "s": s,
+        "p": alt.p.clone().map_or(J::Null, J::String),
+        "r": alt.r.clone().map_or(J::Null, J::String),
+        "b": alt.b,
+        "c": c,
+        "n": object_or_null(n.into_iter().map(|(k, v)| (k.clone(), json!(v))).collect()),
+        "u": object_or_null(u),
+        "k": object_or_null(k),
+        "g": g,
+        "a": if actions.is_empty() { J::Null } else { J::Array(actions) },
+        "e": if alt.e.is_some() || alt.e_match.is_some() { local() } else { J::Null },
+        "h": if alt.h.is_some() || alt.h_match.is_some() { local() } else { J::Null },
+    })
+}
+
+/// A function slot: builtins by name and config, grammar functions by kind.
+fn fn_matches(ts: &J, rust: &J) -> bool {
+    match (ts.get("ref"), rust.get("ref")) {
+        (Some(_), _) | (_, Some(_)) => ts == rust,
+        _ => {
+            ts.get("fn").is_some() == rust.get("fn").is_some() && ts.is_object() == rust.is_object()
+        }
+    }
+}
+
+/// A value with every number as a float: the engine holds numbers as
+/// `f64`, so a condition's `0` comes back as `0.0`, which JSON does not
+/// distinguish and `serde_json` does.
+fn floats(value: &J) -> J {
+    match value {
+        J::Number(number) => json!(number.as_f64()),
+        J::Array(items) => J::Array(items.iter().map(floats).collect()),
+        J::Object(entries) => J::Object(
+            entries
+                .iter()
+                .map(|(key, item)| (key.clone(), floats(item)))
+                .collect(),
+        ),
+        other => other.clone(),
+    }
+}
+
+fn field_matches(field: &str, ts: &J, rust: &J) -> bool {
+    let (ts, rust) = (&floats(ts), &floats(rust));
+    match field {
+        "e" | "h" => fn_matches(ts, rust),
+        "c" if ts.get("fn").is_some() || rust.get("fn").is_some() => fn_matches(ts, rust),
+        "a" => match (ts.as_array(), rust.as_array()) {
+            (Some(t), Some(r)) => {
+                t.len() == r.len() && t.iter().zip(r).all(|(t, r)| fn_matches(t, r))
+            }
+            _ => ts == rust,
+        },
+        _ => ts == rust,
+    }
+}
+
+/// Every way the grammar installed on `parser` departs from `rules`.
+fn diff(parser: &Tabnas, rules: &Map<String, J>) -> Vec<String> {
+    let mut diffs = Vec::new();
+    let mut installed: Vec<&String> = parser.rules.keys().collect();
+    let mut expected: Vec<&String> = rules.keys().collect();
+    installed.sort();
+    expected.sort();
+    if installed != expected {
+        diffs.push(format!("rules: rust {installed:?}, ts {expected:?}"));
+    }
+    for (name, states) in rules {
+        let Some(spec) = parser.rules.get(name) else {
+            continue;
+        };
+        for (state, alts) in [("open", &spec.open), ("close", &spec.close)] {
+            let want = states[state].as_array().cloned().unwrap_or_default();
+            if alts.len() != want.len() {
+                diffs.push(format!(
+                    "{name}.{state}: rust has {} alternates, ts {}",
+                    alts.len(),
+                    want.len()
+                ));
+            }
+            for (index, (alt, want)) in alts.iter().zip(&want).enumerate() {
+                let got = dump_alt(parser, alt);
+                for field in FIELDS {
+                    if !field_matches(field, &want[field], &got[field]) {
+                        diffs.push(format!(
+                            "{name}.{state}[{index}] (g={}) {field}: rust {}, ts {}",
+                            want["g"], got[field], want[field]
+                        ));
+                    }
+                }
+            }
+        }
+    }
+    diffs
+}
+
+#[test]
+fn the_installed_alternates_are_the_typescript_ones() {
+    let fixture = fixture();
+    let profiles = fixture["profiles"].as_object().expect("profiles");
+    assert!(!profiles.is_empty(), "no profiles");
+    let mut failures = Vec::new();
+    for (name, profile) in profiles {
+        let parser = make_profile(&profile["options"])
+            .unwrap_or_else(|error| panic!("profile {name}: {error}"));
+        let rules = profile["rules"].as_object().expect("rules");
+        failures.extend(
+            diff(&parser, rules)
+                .into_iter()
+                .map(|d| format!("{name}: {d}")),
+        );
+    }
+    assert!(failures.is_empty(), "{}", failures.join("\n"));
+}
+
+#[test]
+fn a_departure_is_reported() {
+    // The comparison must be able to fail, or the test above could pass by
+    // comparing nothing: an alternate that loses its allocating action,
+    // and one whose builtin config changes, are both reported.
+    let fixture = fixture();
+    let rules = fixture["profiles"]["default"]["rules"]
+        .as_object()
+        .expect("a default profile");
+    let mut parser = tabnas_jsonic::make();
+    assert_eq!(diff(&parser, rules), Vec::<String>::new());
+
+    let mut map = parser.rules.get("map").expect("map rule").clone();
+    map.open[2].a.clear();
+    map.open[3].action_configs.clear();
+    parser.rules.insert("map".to_string(), map);
+
+    let diffs = diff(&parser, rules);
+    assert_eq!(diffs.len(), 2, "{diffs:?}");
+    assert!(
+        diffs[0].starts_with("map.open[2]") && diffs[0].contains(" a: "),
+        "{}",
+        diffs[0]
+    );
+    assert!(
+        diffs[1].starts_with("map.open[3]") && diffs[1].contains(" a: "),
+        "{}",
+        diffs[1]
+    );
+}
+
+#[test]
+fn an_unknown_profile_option_is_refused() {
+    let Err(error) = make_profile(&json!({ "number": { "hex": false } })) else {
+        panic!("an option the grammar does not depend on must be refused");
+    };
+    assert!(error.contains("unsupported option"), "{error}");
+}
