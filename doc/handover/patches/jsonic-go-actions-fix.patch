+/* Copyright (c) 2026 Richard Rodger and other contributors, MIT License */
+'use strict'
+
+// The canonical grammar's installed alternates, as data.
+//
+// test/grammar/alternates.json is what this writes: for each option profile
+// below, every rule's open and close alternates exactly as the TypeScript
+// grammar installs them, in order, in a form no runtime owns. The Go and
+// Rust suites hold their own installed grammars to that file
+// (go/grammar_alts_test.go, rs/tests/grammar_alts_test.rs), and
+// grammar-alts.test.js fails when the file no longer matches this grammar. After a deliberate grammar change, rewrite it:
+//
+//   node test/grammar-alts.js --write
+//
+// WHERE THE DATA COMES FROM. The rule specs are read through the engine's
+// rule inspection API, `tabnas.rule()`, whose `def.open` / `def.close` are
+// the installed alternates in parse order. Normalisation consumes part of
+// what an alternate declared: an action or condition written by name
+// (`a: '@object$'`) becomes the function it names, a declarative condition
+// (`c: { d: 0 }`) becomes a compiled function, and a builtin's config
+// (`k: { object$: { implicit: true } }`) is bound into the action and taken
+// out of `k`. So the declaration each installed alternate was normalised
+// from is recorded as the grammar is built, keyed by the alternate object
+// itself (normalisation rewrites it in place), and the fields normalisation
+// keeps are checked against the installed alternate, so a recorded
+// declaration can never stand in for a different alternate.
+//
+// THE FORM. One object per alternate:
+//
+//   s  token names per position, as declared (`#KEY`, not the tins it
+//      resolves to): '#KEY #CL' is [['#KEY'], ['#CL']], ['#CB #CS'] is
+//      [['#CB', '#CS']]
+//   p, r  rule names, or null;  b  the backtrack count (0 for none)
+//   c  a declarative condition as { path: { $op: value } }, a named
+//      condition as { fn: name }, or null
+//   n, u, k  as declared, or null; k without the builtin config the
+//      actions consumed
+//   g  the group tags, sorted
+//   a  the actions in order: { ref: '@reset$' } for an engine builtin
+//      ({ ref: '@object$', implicit: false } for the two builders whose
+//      config is the implicit flag), { fn: '@pairkey' } for a grammar
+//      function named by reference, { fn: '' } for an inline one; or null
+//   e, h  the same function form, or null
+//
+// A grammar function's name is recorded where this grammar names it by
+// reference (@finish, @pairkey, @val-close-error) and left empty where it
+// is inline. The Go runner holds the port to those names; the Rust runner
+// compares grammar functions as such, because the Rust engine keeps no
+// name for an alternate's error function. Builtins are compared by name
+// and config everywhere.
+
+const Fs = require('node:fs')
+const Path = require('node:path')
+
+const { findSpecDir } = require('@tabnas/support')
+
+const { Tabnas, BUILTIN_REFS, makeRuleSpec } = require('@tabnas/parser')
+
+const OUT = Path.join(findSpecDir(__dirname), '..', 'grammar', 'alternates.json')
+
+// The option profiles. The grammar is option-conditional in three places
+// (map.child, list.child, and the list.property / list.pair guard on a pair
+// inside a list), so each is exercised on and off.
+const PROFILES = {
+  default: {},
+  child: { map: { child: true }, list: { child: true } },
+  'no-list-property': { list: { property: false, pair: false } },
+}
+
+const RULES = ['val', 'map', 'list', 'pair', 'elem']
+
+// Plain-data copy of a declaration, taken before normalisation touches it.
+function copy(v) {
+  if ('function' === typeof v) return { fn$: v }
+  if (Array.isArray(v)) return v.map(copy)
+  if (null != v && 'object' === typeof v) {
+    const o = {}
+    for (const k of Object.keys(v)) o[k] = copy(v[k])
+    return o
+  }
+  return v
+}
+
+// Record the declaration of every alternate added while `build` runs.
+function recording(build) {
+  const probe = new Tabnas()
+  const proto = Object.getPrototypeOf(
+    makeRuleSpec(probe, probe.internal().config, {}),
+  )
+  const add = proto.add
+  const declared = new WeakMap()
+  proto.add = function (rs, a, mods) {
+    for (const alt of [].concat(a)) {
+      if (null != alt && 'object' === typeof alt && !declared.has(alt)) {
+        declared.set(alt, copy(alt))
+      }
+    }
+    return add.call(this, rs, a, mods)
+  }
+  try {
+    return { built: build(), declared }
+  } finally {
+    proto.add = add
+  }
+}
+
+function fnForm(v, k) {
+  if (null == v) return null
+  if ('string' === typeof v) {
+    if (null != BUILTIN_REFS[v]) {
+      const out = { ref: v }
+      const key = v.slice(1)
+      const cfg = k[key]
+      delete k[key]
+      if ('@object$' === v || '@array$' === v) {
+        out.implicit = !!(cfg && cfg.implicit)
+      } else if (null != cfg && 0 < Object.keys(cfg).length) {
+        out.cfg = cfg
+      }
+      return out
+    }
+    return { fn: v }
+  }
+  return { fn: '' }
+}
+
+function slots(j, s) {
+  const name = (x) => ('number' === typeof x ? j.token[x] : x)
+  if (null == s || 0 === s.length) return []
+  if ('string' === typeof s) return s.trim().split(/\s+/).map((n) => [n])
+  return s.map((pos) =>
+    [].concat(pos).flatMap((x) =>
+      'string' === typeof x ? x.trim().split(/\s+/) : [name(x)],
+    ),
+  )
+}
+
+function cond(c, k) {
+  if (null == c) return null
+  if ('object' === typeof c && null == c.fn$) {
+    const out = {}
+    for (const [path, spec] of Object.entries(c)) {
+      out[path] = null != spec && 'object' === typeof spec ? spec : { $eq: spec }
+    }
+    return out
+  }
+  return fnForm('string' === typeof c ? c : c.fn$, k)
+}
+
+function rulename(v) {
+  return null == v || '' === v ? null : 'string' === typeof v ? v : { fn: '' }
+}
+
+function canon(j, alt, d, where) {
+  if (null == d) {
+    throw new Error('grammar-alts: no recorded declaration for ' + where)
+  }
+  const k = null == d.k ? {} : { ...d.k }
+  const a = null == d.a ? [] : [].concat(d.a).map((x) =>
+    fnForm(null != x && x.fn$ ? x.fn$ : x, k))
+  const g = (null == d.g ? [] : 'string' === typeof d.g ? d.g.split(',') : d.g)
+    .map((t) => t.trim())
+    .filter(Boolean)
+    .sort()
+
+  const out = {
+    s: slots(j, d.s),
+    p: rulename(d.p),
+    r: rulename(d.r),
+    b: d.b || 0,
+    c: cond(d.c, k),
+    n: d.n || null,
+    u: d.u || null,
+    k: null,
+    g,
+    a: 0 < a.length ? a : null,
+    e: null == d.e ? null : fnForm(d.e.fn$ || d.e, k),
+    h: null == d.h ? null : fnForm(d.h.fn$ || d.h, k),
+  }
+  out.k = 0 < Object.keys(k).length ? k : null
+
+  // The fields normalisation keeps must agree with the installed alternate.
+  const kept = {
+    p: rulename(alt.p),
+    r: rulename(alt.r),
+    b: alt.b || 0,
+    n: alt.n || null,
+    u: alt.u || null,
+    g: [...alt.g].sort(),
+    sN: alt.sN,
+  }
+  const declared = {
+    p: out.p,
+    r: out.r,
+    b: out.b,
+    n: out.n,
+    u: out.u,
+    g: out.g,
+    sN: out.s.length,
+  }
+  if (JSON.stringify(kept) !== JSON.stringify(declared)) {
+    throw new Error(
+      'grammar-alts: recorded declaration does not match the installed ' +
+        'alternate at ' + where + ': ' + JSON.stringify({ kept, declared }),
+    )
+  }
+  return out
+}
+
+// The dump of one instance: every rule's installed alternates, in order.
+function dumpRules(j, declared) {
+  const rsm = j.rule()
+  const rules = {}
+  for (const rn of Object.keys(rsm).sort()) {
+    rules[rn] = {}
+    for (const state of ['open', 'close']) {
+      rules[rn][state] = rsm[rn].def[state].map((alt, i) =>
+        canon(j, alt, declared.get(alt), rn + '.' + state + '[' + i + ']'),
+      )
+    }
+  }
+  return rules
+}
+
+function dumpGrammar() {
+  const { Jsonic } = require('..')
+  const profiles = {}
+  for (const [name, options] of Object.entries(PROFILES)) {
+    const { built, declared } = recording(() => Jsonic.make(options))
+    const rules = dumpRules(built, declared)
+    if (JSON.stringify(Object.keys(rules)) !== JSON.stringify([...RULES].sort())) {
+      throw new Error('grammar-alts: unexpected rule set ' + Object.keys(rules))
+    }
+    profiles[name] = { options, rules }
+  }
+  return {
+    about:
+      'The alternates the TypeScript grammar installs, per option profile. ' +
+      'Written by ts/test/grammar-alts.js; see that file for the form.',
+    profiles,
+  }
+}
+
+// JSON with one alternate per line, so a change to the grammar reads as a
+// change to the lines of the alternates it touched.
+function render(dump) {
+  const I = (n) => ' '.repeat(n)
+  const J = JSON.stringify
+  const lines = ['{', I(2) + '"about": ' + J(dump.about) + ',', I(2) + '"profiles": {']
+  const names = Object.keys(dump.profiles)
+  names.forEach((name, pI) => {
+    const { options, rules } = dump.profiles[name]
+    lines.push(I(4) + J(name) + ': {')
+    lines.push(I(6) + '"options": ' + J(options) + ',')
+    lines.push(I(6) + '"rules": {')
+    const rns = Object.keys(rules)
+    rns.forEach((rn, rI) => {
+      lines.push(I(8) + J(rn) + ': {')
+      const states = ['open', 'close']
+      states.forEach((state, sI) => {
+        const alts = rules[rn][state]
+        lines.push(I(10) + J(state) + ': [')
+        alts.forEach((alt, aI) => {
+          lines.push(I(12) + J(alt) + (aI < alts.length - 1 ? ',' : ''))
+        })
+        lines.push(I(10) + ']' + (sI < states.length - 1 ? ',' : ''))
+      })
+      lines.push(I(8) + '}' + (rI < rns.length - 1 ? ',' : ''))
+    })
+    lines.push(I(6) + '}')
+    lines.push(I(4) + '}' + (pI < names.length - 1 ? ',' : ''))
+  })
+  lines.push(I(2) + '}', '}')
+  return lines.join('\n') + '\n'
+}
+
+module.exports = { OUT, PROFILES, dumpGrammar, render }
+
+if (require.main === module) {
+  const text = render(dumpGrammar())
+  if (process.argv.includes('--write')) {
+    Fs.mkdirSync(Path.dirname(OUT), { recursive: true })
+    Fs.writeFileSync(OUT, text)
+    console.log('grammar-alts: wrote ' + Path.relative(process.cwd(), OUT))
+  } else {
+    process.stdout.write(text)
+  }
+}
