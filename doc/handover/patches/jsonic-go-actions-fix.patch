+/* Copyright (c) 2026 Richard Rodger and other contributors, MIT License */
+'use strict'
+
+// test/grammar/alternates.json is this grammar's installed alternates, per
+// option profile (see grammar-alts.js for the form and how it is read). The
+// Go and Rust suites hold their own installed grammars to that file, so the
+// file must be THIS grammar's: a change here that the file does not carry
+// would leave the ports agreeing with a grammar TypeScript no longer has.
+
+const { describe, it } = require('node:test')
+const assert = require('node:assert')
+const Fs = require('node:fs')
+
+const { OUT, dumpGrammar, render } = require('./grammar-alts')
+
+describe('grammar-alts', () => {
+  it('the committed dump is the installed grammar', () => {
+    const committed = Fs.readFileSync(OUT, 'utf8')
+    const live = dumpGrammar()
+    assert.deepStrictEqual(
+      JSON.parse(committed),
+      live,
+      'test/grammar/alternates.json is stale: run `node test/grammar-alts.js --write` in ts/',
+    )
+    // Byte for byte as well, so the file is always the generator's output.
+    assert.equal(committed, render(live))
+  })
+
+  it('containers are allocated by the open alternates', () => {
+    // The shape the Go port once departed from: every map open alternate
+    // allocates with @object$, json's two list open alternates and the
+    // top-level comma alternate with @array$, and the brace-less ones say
+    // so with the static implicit flag.
+    const { rules } = dumpGrammar().profiles.default
+    const acts = (alts) => alts.map((alt) => alt.a)
+    assert.deepEqual(acts(rules.map.open), [
+      [{ ref: '@object$', implicit: false }],
+      [{ ref: '@object$', implicit: false }],
+      [{ ref: '@object$', implicit: false }],
+      [{ ref: '@object$', implicit: true }],
+    ])
+    assert.deepEqual(acts(rules.list.open), [
+      null,
+      [{ ref: '@array$', implicit: false }],
+      [{ ref: '@array$', implicit: false }],
+      null,
+      null,
+    ])
+    assert.deepEqual(rules.val.open[6].a, [{ ref: '@array$', implicit: true }])
+  })
+})
