diff --git a/go/grammar_alts_test.go b/go/grammar_alts_test.go
new file mode 100644
index 0000000..b9ca86d
--- /dev/null
+++ b/go/grammar_alts_test.go
@@ -0,0 +1,377 @@
+// Copyright (c) 2026 Richard Rodger, MIT License
+
+package tabnasjsonic
+
+// The installed alternates of every jsonic rule are the TypeScript ones,
+// alternate for alternate: the same order, token slots, push, replace,
+// backtrack, condition, counters, props, groups, and the same actions,
+// down to the builtin each alternate runs and its config.
+//
+// test/grammar/alternates.json is the TypeScript grammar's own dump, per
+// option profile, written by ts/test/grammar-alts.js (whose header
+// describes the form) and held to the live TypeScript grammar by
+// ts/test/grammar-alts.test.js; rs/tests/grammar_alts_test.rs is the Rust
+// runner. This test dumps the grammar Go installed through the engine's
+// rule inspection API (RSM, OpenAlts, CloseAlts) into the same form and
+// compares.
+//
+// The port once departed from it here: it allocated maps and lists in the
+// before-open phase and re-declared @tabnas/json's `#OB`/`#OS` open
+// alternates without their @object$/@array$ actions, so its alternates were
+// not TypeScript's even though its parses were.
+//
+// A function on an alternate is named the way the dump names it: an engine
+// builtin by its ref (and the implicit flag its config binds, read by
+// running it), a jsonic function by its name in jsonicRefs. Where the
+// TypeScript grammar names a function (@finish, @pairkey, @val-close-error)
+// Go must use that name; where TypeScript writes it inline, any jsonic
+// function matches.
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"sort"
+	"strings"
+	"testing"
+
+	tabnas "github.com/tabnas/parser/go"
+)
+
+type grammarAltsFixture struct {
+	About    string `json:"about"`
+	Profiles map[string]struct {
+		Options map[string]any                         `json:"options"`
+		Rules   map[string]map[string][]map[string]any `json:"rules"`
+	} `json:"profiles"`
+}
+
+func loadGrammarAlts(t *testing.T) grammarAltsFixture {
+	t.Helper()
+	path := filepath.Join(specDir(), "..", "grammar", "alternates.json")
+	src, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read %s: %v", path, err)
+	}
+	var fx grammarAltsFixture
+	if err := json.Unmarshal(src, &fx); err != nil {
+		t.Fatalf("parse %s: %v", path, err)
+	}
+	if len(fx.Profiles) == 0 {
+		t.Fatalf("%s has no profiles", path)
+	}
+	return fx
+}
+
+// funcName is the runtime name of a function value's code: every closure
+// made from one function literal shares it.
+func funcName(fn any) string {
+	v := reflect.ValueOf(fn)
+	if !v.IsValid() || v.Kind() != reflect.Func || v.IsNil() {
+		return ""
+	}
+	return runtime.FuncForPC(v.Pointer()).Name()
+}
+
+// altDumper names the functions it finds on installed alternates.
+type altDumper struct {
+	j        *Jsonic
+	builtins map[string]string // runtime name -> builtin ref
+	locals   map[string]string // runtime name -> jsonic ref
+}
+
+func newAltDumper(j *Jsonic) *altDumper {
+	d := &altDumper{j: j, builtins: map[string]string{}, locals: map[string]string{}}
+	for name, fn := range tabnas.BUILTIN_REFS {
+		d.builtins[funcName(fn)] = string(name)
+	}
+	// A builtin with config is bound when the grammar loads, into a
+	// closure its factory makes.
+	for name, factory := range tabnas.BUILTIN_CONFIG_FACTORY {
+		d.builtins[funcName(factory(nil))] = string(name)
+	}
+	for name, fn := range jsonicRefs(&LexConfig{}) {
+		if _, builtin := tabnas.BUILTIN_REFS[name]; !builtin {
+			d.locals[funcName(fn)] = string(name)
+		}
+	}
+	return d
+}
+
+func (d *altDumper) fn(fn any) map[string]any {
+	rt := funcName(fn)
+	if ref, ok := d.builtins[rt]; ok {
+		out := map[string]any{"ref": ref}
+		if ref == "@object$" || ref == "@array$" {
+			// The config is bound into the closure; run it to read the
+			// implicit flag it carries.
+			r := &Rule{}
+			ctx := &Context{Cfg: &LexConfig{MapRef: true, ListRef: true}}
+			fn.(AltAction)(r, ctx)
+			switch node := r.Node.(type) {
+			case MapRef:
+				out["implicit"] = node.Implicit
+			case ListRef:
+				out["implicit"] = node.Implicit
+			}
+		}
+		return out
+	}
+	if ref, ok := d.locals[rt]; ok {
+		return map[string]any{"fn": ref}
+	}
+	return map[string]any{"fn": "?" + rt}
+}
+
+func (d *altDumper) alt(a *AltSpec) map[string]any {
+	s := [][]string{}
+	if a.SNames != nil {
+		s = a.SNames
+	} else {
+		for _, pos := range a.S {
+			names := []string{}
+			for _, tin := range pos {
+				names = append(names, d.j.TinName(tin))
+			}
+			s = append(s, names)
+		}
+	}
+
+	g := []string{}
+	for _, tag := range strings.Split(a.G, ",") {
+		if tag = strings.TrimSpace(tag); tag != "" {
+			g = append(g, tag)
+		}
+	}
+	sort.Strings(g)
+
+	name := func(v string, fn any) any {
+		if !reflect.ValueOf(fn).IsNil() {
+			return d.fn(fn)
+		}
+		if v == "" {
+			return nil
+		}
+		return v
+	}
+
+	out := map[string]any{
+		"s": s,
+		"p": name(a.P, a.PF),
+		"r": name(a.R, a.RF),
+		"b": a.B,
+		"c": nil,
+		"n": nil,
+		"u": nil,
+		"k": nil,
+		"g": g,
+		"a": nil,
+		"e": nil,
+		"h": nil,
+	}
+	if a.BF != nil {
+		out["b"] = d.fn(a.BF)
+	}
+	if a.CD != nil {
+		cd := map[string]any{}
+		for path, spec := range a.CD {
+			switch v := spec.(type) {
+			case tabnas.CondOp:
+				cd[path] = map[string]any{v.Op: v.Val}
+			case map[string]any:
+				cd[path] = v
+			default:
+				cd[path] = map[string]any{"$eq": v}
+			}
+		}
+		out["c"] = cd
+	} else if a.C != nil {
+		out["c"] = d.fn(a.C)
+	}
+	if len(a.N) > 0 {
+		out["n"] = a.N
+	}
+	if len(a.U) > 0 {
+		out["u"] = a.U
+	}
+	if len(a.K) > 0 {
+		out["k"] = a.K
+	}
+	if a.A != nil {
+		out["a"] = []any{d.fn(a.A)}
+	}
+	if a.E != nil {
+		out["e"] = d.fn(a.E)
+	}
+	if a.H != nil {
+		out["h"] = d.fn(a.H)
+	}
+
+	// Through JSON, so numbers and maps compare as the fixture's do.
+	var norm map[string]any
+	b, _ := json.Marshal(out)
+	_ = json.Unmarshal(b, &norm)
+	return norm
+}
+
+// fnMatches: the same builtin and config, the same name where TypeScript
+// names the function, and any jsonic function where TypeScript is inline.
+func fnMatches(ts, gov any) bool {
+	tm, tok := ts.(map[string]any)
+	gm, gok := gov.(map[string]any)
+	if !tok || !gok {
+		return reflect.DeepEqual(ts, gov)
+	}
+	if _, isRef := tm["ref"]; isRef {
+		return reflect.DeepEqual(tm, gm)
+	}
+	tname, tfn := tm["fn"].(string)
+	gname, gfn := gm["fn"].(string)
+	if !tfn || !gfn {
+		return false
+	}
+	if tname == "" {
+		return !strings.HasPrefix(gname, "?")
+	}
+	return tname == gname
+}
+
+func altFieldMatches(field string, ts, gov any) bool {
+	switch field {
+	case "e", "h":
+		return fnMatches(ts, gov)
+	case "c", "p", "r", "b":
+		if tm, ok := ts.(map[string]any); ok {
+			if _, isFn := tm["fn"]; isFn {
+				return fnMatches(ts, gov)
+			}
+		}
+		return reflect.DeepEqual(ts, gov)
+	case "a":
+		tl, tok := ts.([]any)
+		gl, gok := gov.([]any)
+		if !tok || !gok {
+			return reflect.DeepEqual(ts, gov)
+		}
+		if len(tl) != len(gl) {
+			return false
+		}
+		for i := range tl {
+			if !fnMatches(tl[i], gl[i]) {
+				return false
+			}
+		}
+		return true
+	}
+	return reflect.DeepEqual(ts, gov)
+}
+
+var altFields = []string{"s", "p", "r", "b", "c", "n", "u", "k", "g", "a", "e", "h"}
+
+// diffGrammarAlts lists every way the installed grammar of j departs from
+// the TypeScript one in rules.
+func diffGrammarAlts(j *Jsonic, rules map[string]map[string][]map[string]any) []string {
+	var diffs []string
+	d := newAltDumper(j)
+	rsm := j.RSM()
+
+	var goRules, tsRules []string
+	for rn := range rsm {
+		goRules = append(goRules, rn)
+	}
+	for rn := range rules {
+		tsRules = append(tsRules, rn)
+	}
+	sort.Strings(goRules)
+	sort.Strings(tsRules)
+	if !reflect.DeepEqual(goRules, tsRules) {
+		diffs = append(diffs, fmt.Sprintf("rules: go %v, ts %v", goRules, tsRules))
+	}
+
+	for _, rn := range tsRules {
+		rs := rsm[rn]
+		if rs == nil {
+			continue
+		}
+		for _, state := range []string{"open", "close"} {
+			installed := rs.OpenAlts()
+			if state == "close" {
+				installed = rs.CloseAlts()
+			}
+			want := rules[rn][state]
+			if len(installed) != len(want) {
+				diffs = append(diffs, fmt.Sprintf("%s.%s: go has %d alternates, ts %d",
+					rn, state, len(installed), len(want)))
+			}
+			for i := 0; i < len(installed) && i < len(want); i++ {
+				got := d.alt(installed[i])
+				for _, f := range altFields {
+					if !altFieldMatches(f, want[i][f], got[f]) {
+						gj, _ := json.Marshal(got[f])
+						tj, _ := json.Marshal(want[i][f])
+						diffs = append(diffs, fmt.Sprintf("%s.%s[%d] (g=%v) %s: go %s, ts %s",
+							rn, state, i, want[i]["g"], f, gj, tj))
+					}
+				}
+			}
+		}
+	}
+	return diffs
+}
+
+func TestGrammarAlternatesAreTypeScripts(t *testing.T) {
+	fx := loadGrammarAlts(t)
+	names := make([]string, 0, len(fx.Profiles))
+	for name := range fx.Profiles {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	for _, name := range names {
+		profile := fx.Profiles[name]
+		t.Run(name, func(t *testing.T) {
+			opts, err := tabnas.OptionsFromMap(profile.Options)
+			if err != nil {
+				t.Fatalf("options %v: %v", profile.Options, err)
+			}
+			for _, diff := range diffGrammarAlts(Make(opts), profile.Rules) {
+				t.Error(diff)
+			}
+		})
+	}
+}
+
+// The comparison must be able to fail: an alternate that loses its
+// allocating action, and one whose builtin config changes, are both
+// reported. Without this the test above could pass by comparing nothing.
+func TestGrammarAlternatesComparisonDetectsDrift(t *testing.T) {
+	fx := loadGrammarAlts(t)
+	rules := fx.Profiles["default"].Rules
+	if rules == nil {
+		t.Fatal("no default profile")
+	}
+
+	j := Make()
+	if diffs := diffGrammarAlts(j, rules); len(diffs) != 0 {
+		t.Fatalf("default profile differs before any edit: %v", diffs)
+	}
+
+	// The shape this port used to have: json's `{` alternate without its
+	// @object$ action.
+	j.RSM()["map"].OpenAlts()[2].A = nil
+	// And the brace-less map marked explicit.
+	j.RSM()["map"].OpenAlts()[3].A = tabnas.BUILTIN_CONFIG_FACTORY["@object$"](nil)
+
+	diffs := diffGrammarAlts(j, rules)
+	want := []string{"map.open[2]", "map.open[3]"}
+	if len(diffs) != len(want) {
+		t.Fatalf("want %d differences, got %d: %v", len(want), len(diffs), diffs)
+	}
+	for i, prefix := range want {
+		if !strings.HasPrefix(diffs[i], prefix) || !strings.Contains(diffs[i], " a: ") {
+			t.Errorf("difference %d: want %s ... a:, got %s", i, prefix, diffs[i])
+		}
+	}
+}
