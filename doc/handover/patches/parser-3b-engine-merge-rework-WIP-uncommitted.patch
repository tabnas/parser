index 0000000..5bf1454
--- /dev/null
+++ b/go/merge_fixed_test.go
@@ -0,0 +1,227 @@
+// Copyright (c) 2013-2026 Richard Rodger, MIT License
+
+// How a merge treats removed and rebound fixed tokens, mirroring the
+// merge-removals tests in ts/test/merge.test.js and the fixed-token tests
+// in rs/tests/merge_test.rs.
+
+package tabnas
+
+import (
+	"reflect"
+	"testing"
+)
+
+// fixedStep is one grammar applied to a merge side: a fixed.token map,
+// where a nil value removes the name, or a clear.
+type fixedStep map[string]any
+
+var clearStep = fixedStep{"clear$": true}
+
+// fixedSide builds a merge side under tag, applying each step through the
+// serialized-options door a plugin's fixed.token removals come through.
+func fixedSide(t *testing.T, tag string, steps ...fixedStep) *Tabnas {
+	t.Helper()
+	j := Make(Options{Tag: tag})
+	for _, step := range steps {
+		gs := &GrammarSpec{}
+		if step["clear$"] == true {
+			gs.Clear = true
+		} else {
+			gs.OptionsMap = map[string]any{
+				"fixed": map[string]any{"token": map[string]any(step)},
+			}
+		}
+		if err := j.Grammar(gs); err != nil {
+			t.Fatalf("Grammar(%v): %v", step, err)
+		}
+	}
+	return j
+}
+
+// lexedName is the name of the first token j lexes src into.
+func lexedName(j *Tabnas, src string) string {
+	lex := NewLex(src, j.Config())
+	tk := lex.Next()
+	if lex.Err != nil {
+		return "ERR"
+	}
+	if tk == nil {
+		return "ZZ"
+	}
+	return tk.Name
+}
+
+// fixedMerges is every merge of a side built from one's steps with a side
+// built from other's: the first side sorts first and last by tag, and each
+// is the receiver once, so no order can hide a result.
+func fixedMerges(t *testing.T, one, other []fixedStep) []func() (*Tabnas, error) {
+	t.Helper()
+	var out []func() (*Tabnas, error)
+	for _, tags := range [][2]string{{"A", "B"}, {"B", "A"}} {
+		for _, oneReceives := range []bool{true, false} {
+			tags, oneReceives := tags, oneReceives
+			out = append(out, func() (*Tabnas, error) {
+				a := fixedSide(t, tags[0], one...)
+				b := fixedSide(t, tags[1], other...)
+				if oneReceives {
+					return a.Merge(b)
+				}
+				return b.Merge(a)
+			})
+		}
+	}
+	return out
+}
+
+func mustMerge(t *testing.T, merge func() (*Tabnas, error)) *Tabnas {
+	t.Helper()
+	m, err := merge()
+	if err != nil {
+		t.Fatalf("Merge error: %v", err)
+	}
+	return m
+}
+
+func expectLexed(t *testing.T, j *Tabnas, want map[string]string) {
+	t.Helper()
+	for src, name := range want {
+		if got := lexedName(j, src); got != name {
+			t.Errorf("%q lexes as %s, want %s", src, got, name)
+		}
+	}
+}
+
+// A binding one side removed comes back from the other side: TypeScript's
+// configure() deletes a fixed token set to null from the option tree a
+// merge reads, so the merge takes what the other side holds, default or
+// not, and a removal met by a rebinding is no conflict.
+func TestMergeRestoresAFixedTokenOneSideRemoved(t *testing.T) {
+	remove := fixedStep{"#OS": nil, "#CS": nil}
+	if got := lexedName(fixedSide(t, "A", remove), "["); got != "#TX" {
+		t.Fatalf("a side alone lexes [ as %s, want #TX", got)
+	}
+	for _, merge := range fixedMerges(t, []fixedStep{remove}, nil) {
+		expectLexed(t, mustMerge(t, merge), map[string]string{"[": "#OS", "]": "#CS"})
+	}
+	for _, merge := range fixedMerges(t, []fixedStep{clearStep}, nil) {
+		expectLexed(t, mustMerge(t, merge), map[string]string{"[": "#OS", "{": "#OB"})
+	}
+	rebind := fixedStep{"#OS": "<<"}
+	for _, merge := range fixedMerges(t, []fixedStep{remove}, []fixedStep{rebind}) {
+		expectLexed(t, mustMerge(t, merge), map[string]string{"<<": "#OS", "[": "#TX"})
+	}
+	// A side that bound a name and then cleared it holds nothing for it,
+	// so the other side's binding is no conflict, however the first side
+	// once bound it.
+	for _, merge := range fixedMerges(t,
+		[]fixedStep{{"#OB": "("}, clearStep}, []fixedStep{{"#OB": "<"}}) {
+		expectLexed(t, mustMerge(t, merge), map[string]string{"<": "#OB", "(": "#TX"})
+	}
+}
+
+// A default binding neither side holds comes back, as TypeScript builds
+// the merged instance over the defaults.
+func TestMergeRestoresADefaultFixedTokenNeitherSideHolds(t *testing.T) {
+	remove := fixedStep{"#OS": nil}
+	for _, merge := range fixedMerges(t, []fixedStep{remove}, []fixedStep{remove}) {
+		expectLexed(t, mustMerge(t, merge), map[string]string{"[": "#OS"})
+	}
+	for _, merge := range fixedMerges(t, []fixedStep{clearStep}, []fixedStep{clearStep}) {
+		expectLexed(t, mustMerge(t, merge), map[string]string{
+			"{": "#OB", "}": "#CB", "[": "#OS", "]": "#CS", ":": "#CL", ",": "#CA",
+		})
+	}
+
+	// Where a default put back and a binding a side holds claim one
+	// source, the later of the two in the defaults' order lexes it: a name
+	// the defaults lack, or a default name after it, keeps the source.
+	for _, c := range []struct {
+		bind         fixedStep
+		lexes, freed string
+		freedLexesAs string
+	}{
+		{fixedStep{"#OS": nil, "#LB": "["}, "#LB", "{", "#OB"},
+		{fixedStep{"#OS": nil, "#CA": "["}, "#CA", ",", "#TX"},
+		{fixedStep{"#OS": nil, "#OB": "["}, "#OS", "{", "#TX"},
+	} {
+		for _, merge := range fixedMerges(t, []fixedStep{c.bind}, []fixedStep{c.bind}) {
+			m := mustMerge(t, merge)
+			expectLexed(t, m, map[string]string{"[": c.lexes, c.freed: c.freedLexesAs})
+		}
+	}
+
+	// A binding that comes back takes its place in the defaults' order, so
+	// a later rebinding onto its source is decided as in TypeScript.
+	for _, merge := range fixedMerges(t, []fixedStep{{"#OB": nil}}, nil) {
+		m := mustMerge(t, merge)
+		if err := m.Grammar(&GrammarSpec{OptionsMap: map[string]any{
+			"fixed": map[string]any{"token": map[string]any{"#CA": "{"}},
+		}}); err != nil {
+			t.Fatal(err)
+		}
