+        let removed = spec_side(right_tag, &[&fixed_step(r##""#OS":null"##)]);
+        for merged in [empty.merge(&removed), removed.merge(&empty)] {
+            let merged = merged.unwrap();
+            assert!(!merged.options.defaults);
+            assert_eq!(None, merged.fixed("["));
+            assert_eq!(Some("{"), merged.fixed("{").and_then(|tin| merged.fixed_source(tin)));
+        }
+    }
+}
+
+#[test]
+fn a_custom_token_in_an_instance_without_the_defaults_has_its_own_identity() {
+    // An empty instance registers #OS at its built-in identity, and the next
+    // name took the identity after it, #CS's, so `(` was named #CS through
+    // `fixed`. A name the built-ins lack is numbered after all of them.
+    let tabnas = empty_side("A", r##""#OS":"]","#XB":"(""##);
+    let xb = tabnas.fixed("(").unwrap();
+    assert!(xb >= tabnas::TIN_MAX);
+    assert_eq!("#XB", tabnas.token_name(xb));
+    assert_eq!("#XB", first_token(&tabnas, "("));
+    assert_eq!("#OS", first_token(&tabnas, "]"));
+}
+
+#[test]
+fn a_grammar_clear_leaves_a_binding_another_shadows() {
+    // Binding #OB to `[` leaves #OS on it too, later in the defaults'
+    // order, so #OS lexes `[`, `fixed("[")` names it, and #OB has no source
+    // of its own. A clear removes what lexes, and #OB is left to lex `[`,
+    // as TypeScript's clear leaves it.
+    let mut tabnas = spec_side("A", &[&fixed_step(r##""#OB":"[""##)]);
+    let os = tabnas.options.fixed.tokens["#OS"].tin;
+    let ob = tabnas.options.fixed.tokens["#OB"].tin;
+    assert_eq!("#OS", first_token(&tabnas, "["));
+    assert_eq!(Some(os), tabnas.fixed("["));
+    assert_eq!(None, tabnas.fixed_source(ob));
+    assert_eq!(Some("["), tabnas.fixed_source(os));
+    tabnas.grammar_json(r#"{"clear":true}"#).unwrap();
+    assert_eq!(vec!["#OB".to_string()], fixed_names(&tabnas));
+    assert_eq!("#OB", first_token(&tabnas, "["));
+    assert_eq!(Some("["), tabnas.fixed_source(ob));
+}
