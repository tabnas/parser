+// Two bindings the sides hold that claim one source are refused before
+// the defaults come back, naming first the one TypeScript's merged option
+// tree holds first: the canonical-first side's names, the defaults in
+// their order, then the other side's.
+func TestMergeRefusesTwoHeldBindingsOnOneSourceInTypeScriptsOrder(t *testing.T) {
+	move := fixedStep{"#OS": nil, "#LB": "["}
+	var errs []string
+	for _, merge := range fixedMerges(t, []fixedStep{move}, nil) {
+		_, err := merge()
+		if err == nil {
+			t.Fatal("merge of a moved source with the default should fail")
+		}
+		errs = append(errs, err.Error())
+	}
+	first := `merge: fixed tokens #LB and #OS both claim source "["`
+	second := `merge: fixed tokens #OS and #LB both claim source "["`
+	if want := []string{first, first, second, second}; !reflect.DeepEqual(errs, want) {
+		t.Fatalf("errors = %q, want %q", errs, want)
+	}
+
+	// Between two default names the tree's order decides, not the names'
+	// spelling: the side that removed #CB holds #CA first, and the default
+	// side holds #CB before #CA.
+	errs = nil
+	for _, merge := range fixedMerges(t, []fixedStep{{"#CA": "}", "#CB": nil}}, nil) {
+		_, err := merge()
+		if err == nil {
+			t.Fatal("merge of #CA on } with the default should fail")
+		}
+		errs = append(errs, err.Error())
+	}
+	ca := `merge: fixed tokens #CA and #CB both claim source "}"`
+	cb := `merge: fixed tokens #CB and #CA both claim source "}"`
+	if want := []string{ca, ca, cb, cb}; !reflect.DeepEqual(errs, want) {
+		t.Fatalf("errors = %q, want %q", errs, want)
+	}
+
+	// Two different bindings of one name conflict, as any option does.
+	for _, merge := range fixedMerges(t, []fixedStep{{"#OB": "("}}, []fixedStep{{"#OB": "<"}}) {
+		_, err := merge()
+		if err == nil || err.Error() != "merge: conflicting option values at fixed.token.#OB" {
+			t.Fatalf("expected a fixed.token.#OB conflict, got %v", err)
+		}
+	}
+}
+
+// An instance derived from a merged one lexes as the merged one does:
+// Derive rebuilds the fixed tokens from the options, which record the
+// merged table, removals and all.
+func TestMergeDerivedInstanceKeepsTheMergedFixedTokens(t *testing.T) {
+	for _, merge := range fixedMerges(t,
+		[]fixedStep{{"#OB": "(", "#OS": nil}}, []fixedStep{{"#XA": "="}}) {
+		m := mustMerge(t, merge)
+		want := map[string]string{"(": "#OB", "{": "#TX", "[": "#OS", "=": "#XA"}
+		expectLexed(t, m, want)
+		child, err := m.Derive()
+		if err != nil {
+			t.Fatal(err)
+		}
+		expectLexed(t, child, want)
+	}
+}
